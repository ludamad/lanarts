{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (with debug info)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "headless",
      "displayName": "Headless release, for simulations and tests",
      "inherits": "release",
      "cacheVariables": { "LANARTS_HEADLESS": "ON" }
    },
    {
      "name": "sanitize",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "inherits": "debug",
      "cacheVariables": { "LANARTS_SANITIZE": "ON" }
    },
    {
      "name": "luajit",
      "displayName": "Release with LuaJIT",
      "inherits": "release",
      "cacheVariables": { "LANARTS_LUAJIT": "ON" }
    },
    {
      "name": "web",
      "displayName": "Emscripten (run inside emcmake, or set EMSCRIPTEN_ROOT)",
      "inherits": "base",
      "toolchainFile": "$env{EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mingw",
      "displayName": "Windows, cross-compiled with MinGW-w64",
      "inherits": "release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake"
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "luajit", "configurePreset": "luajit" },
    { "name": "web", "configurePreset": "web" },
    { "name": "mingw", "configurePreset": "mingw" }
  ],
  "testPresets": [
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
  ]
}
